        "isBlind": false,
        "payNoNI": false,
        "pensionContribution": 0,
        "pensionContributionType": "amount",
        "studentLoanPlans": "none",
        "niCategory": "A",
        "hoursPerWeek": 40,
        "incomeSources": [
          {
            "id": "rent",
            "type": "rental",
            "amount": 2000,
            "period": "monthly"
          }
        ]
      },
      "expected": {
        "incomeTaxMonthly": 390.2,
        "taxableIncomeAnnual": 23412,
        "netPayMonthly": 2609.8,
