{
  "suite": "Mixed-income PAYE and combined-income projections",
  "source": {
    "authority": "HMRC and UK legislation",
    "urls": [
      "https://www.legislation.gov.uk/uksi/2003/2682/made/data.xht",
      "https://www.legislation.gov.uk/uksi/2014/2689/pdfs/uksi_20142689_en.pdf",
      "https://www.gov.uk/hmrc-internal-manuals/paye-manual/paye11025",
